{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "node tools/build-sidecar.mjs && npm run build"
  },
  "bundle": {
    "active": true,
    "externalBin": [
      "binaries/cumplefactura-sidecar"
    ],
    "targets": [
      "nsis"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "Spanish"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  }
}
